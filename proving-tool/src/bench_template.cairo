/// Deterministic pseudo-random payload word (FNV-style felt arithmetic).
fn payload_word(i: usize) -> felt252 {
    let mut x: felt252 = (i + 1).into();
    x = x * 0x100000001b3;
    x = x + 0x9e3779b97f4a7c15;
    x = x * 0x100000001b3;
    x
}

#[executable]
fn main() -> felt252 {
    // --- Phase 1: poseidon challenges over payload slices ---
    let mut acc_hash: felt252 = 0;
    let mut c: usize = 0;
    while c < N_CHALLENGES {
        let mut h = PoseidonTrait::new();
        let mut j: usize = 0;
        while j < WORDS_PER_CHALLENGE {
            h = h.update(payload_word((c * WORDS_PER_CHALLENGE + j) % PAYLOAD_LEN));
            j += 1;
        };
        acc_hash += h.finalize();
        c += 1;
    };

    // --- Phase 2: EC Horner accumulation: acc = acc * rho + P_i ---
    let mut acc: NonZeroEcPoint = bench_point(1).try_into().unwrap();
    let mut e: usize = 0;
    while e < N_EC {
        let rho = payload_word(e % PAYLOAD_LEN) + acc_hash;
        let accp: EcPoint = acc.into();
        let scaled = accp.mul(rho);
        let sum = scaled + bench_point(e % N_POINTS + 1);
        acc = sum.try_into().unwrap();
        e += 1;
    };

    // --- Phase 3: final mix over the whole payload ---
    let mut h2 = PoseidonTrait::new();
    let mut k: usize = 0;
    while k < PAYLOAD_LEN {
        h2 = h2.update(payload_word(k));
        k += 1;
    };
    h2 = h2.update(acc.x());
    h2 = h2.update(acc.y());
    h2 = h2.update(acc_hash);
    h2.finalize()
}
