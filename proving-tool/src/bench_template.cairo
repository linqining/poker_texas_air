//! Custom-scale variant of the hand_verify bench program, generated by `prove-hand
//! --scale <N>` from the same shape as
//! third_party/proving/test_data/test_hand_verify_bench/hand_verify_bench_{small,medium,full}.cairo.

use core::array::ArrayTrait;
use core::ec::{EcPoint, EcPointTrait, NonZeroEcPoint};
use core::poseidon::PoseidonTrait;
use core::hash::HashStateTrait;

const N_CHALLENGES: usize = __N_CHALLENGES__;
const WORDS_PER_CHALLENGE: usize = 16;
const N_EC: usize = __N_EC__;
const PAYLOAD_LEN: usize = __PAYLOAD_LEN__;
const N_POINTS: usize = 16;

/// Hardcoded generator multiples i*G (i = 1..=16) of the STARK curve.
fn bench_point(i: usize) -> EcPoint {
    match i % N_POINTS {
        0 => EcPointTrait::new(874739451078007766457464989774322083649278607533249481151382481072868806602, 152666792071518830868575557812948353041420400780739481342941381225525861407).unwrap(),
        1 => EcPointTrait::new(3324833730090626974525872402899302150520188025637965566623476530814354734325, 3147007486456030910661996439995670279305852583596209647900952752170983517249).unwrap(),
        2 => EcPointTrait::new(1839793652349538280924927302501143912227271479439798783640887258675143576352, 3564972295958783757568195431080951091358810058262272733141798511604612925062).unwrap(),
        3 => EcPointTrait::new(296568192680735721663075531306405401515803196637037431012739700151231900092, 2496008012906462030584867856951610048657271546413643307709739611216909709750).unwrap(),
        4 => EcPointTrait::new(3406946075390113347849186141614382943859026331139362801098460541807050012492, 553286918727390295085862184332748643124765280169853477022816811418017247627).unwrap(),
        5 => EcPointTrait::new(875940955200611947500760302054417515671876219465574517800446702396947535610, 2976950011013311701273347535189853905279003536832852550673682997603920566673).unwrap(),
        6 => EcPointTrait::new(3285470181182513595299391888669018264373825695633626141263541088056464172983, 407217118062758744964593760322705378299439026911040607736478266570367095223).unwrap(),
        7 => EcPointTrait::new(3136030469135674343172465880817263454880219855664441593466904169223571314065, 3230850854683103635133032411878658931556916918508772276704988424959453909526).unwrap(),
        8 => EcPointTrait::new(944745129853146482146311827146531433242387523423467361347719369673366386761, 2394221861052833782597287772330532919046009427329165562185942323334687758988).unwrap(),
        9 => EcPointTrait::new(1414904107774701420161054128842762567969139319263736734867498960113151564766, 3337252540928200396650014175361215244917634305439052419173253778806545007479).unwrap(),
        10 => EcPointTrait::new(1825044824267003615638373110904209640139566204494220120660074112157498504754, 2806073496589763486159133123292931531221247217479322984751676581971468843299).unwrap(),
        11 => EcPointTrait::new(2887847313723422212839457588089656810396956397841585991334919802801880312483, 2501556980703804021276245589869491645101270896766087242305155821365213528106).unwrap(),
