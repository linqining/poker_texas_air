            0x04a0236e7b7f29c1897d5a84b11d81c7cb578fa8769427b729c6f6c799cdcd80
        ]
    }

    #[test]
    fn full_5bucket_contract_fails_closed() {
        // The layer-1 contract rejects any n_shuffle > 0 (bytecode-size
        // fail-closed, see verify_hand_batch_stark); the same payload is
        // accepted by the layer-2 program (hand_verify tests).
        assert!(!verify_hand_batch_stark(BGV_BINDING, full_payload_5bucket().span()));
    }

    #[test]
    fn full_5bucket_tampered_beta_rejected() {
        // shuffle bucket starts at word 10; beta is bucket word 8n+25+n+1
        // = 494 -> payload word 504
        let p = bumped(full_payload_5bucket(), 504);
        assert!(!verify_hand_batch_stark(BGV_BINDING, p.span()));
    }

        pub fn bumped(payload: Array<felt252>, index: u32) -> Array<felt252> {
        let mut out: Array<felt252> = array![];
        let mut i: u32 = 0;
        while i < payload.len() {
            if i == index {
                out.append(*payload.at(i) + 1);
            } else {
                out.append(*payload.at(i));
            }
            i += 1;
        }
        out
    }

    pub fn flipped_binding() -> felt252 {
        HAND_BINDING + 1
    }


    // N=4 honest vector（同一 host 生成器；规模缩放实测用）。
    

    

    #[test]
    fn honest_hand_n4_accepts() {
        assert!(
            verify_hand_batch_stark(HAND_BINDING, payload_n4().span()),
            "honest N=4 hand must fold to L == O"
        );
    }

    #[test]
    fn tampered_n4_last_scalar_rejected() {
        let p = bumped(payload_n4(), 23); // ownership[3].s + 1
        assert!(!verify_hand_batch_stark(HAND_BINDING, p.span()));
    }

    #[test]
    fn honest_hand_accepts() {
        assert!(
            verify_hand_batch_stark(HAND_BINDING, payload().span()),
            "honest hand must fold to L == O on the STARK curve"
        );
    }

    #[test]
    fn tampered_ownership_response_rejected() {
        // ownership[0].s + 1 (word index 8; header is 5 words)
        let p = bumped(payload(), 8);
        assert!(!verify_hand_batch_stark(HAND_BINDING, p.span()));
    }

    #[test]
    fn tampered_public_key_rejected() {
        // ownership[1].pk_x + 1 (word index 10)
        let p = bumped(payload(), 10);
        assert!(!verify_hand_batch_stark(HAND_BINDING, p.span()));
    }

    #[test]
    fn cross_hand_replay_rejected() {
        // Same transcript settled under a different hand instance id: the
        // hand-bound domain changes every challenge, so the fold is nonzero.
        assert!(!verify_hand_batch_stark(flipped_binding(), payload().span()));
    }

    #[test]
    fn malformed_payload_rejected() {
        // Truncated: length walk fails.
        let p = payload();
        assert!(!verify_hand_batch_stark(
            HAND_BINDING,
            p.span().slice(0, 8),
        ));
        // Reserved reveal/fold slots must be zero.
        let mut q: Array<felt252> = array![];
        let mut i: u32 = 0;
        while i < p.len() {
            if i == 1 {
                q.append(1);
            } else {
                q.append(*p.at(i));
            }
            i += 1;
        }
        assert!(!verify_hand_batch_stark(HAND_BINDING, q.span()));
        // Count mismatch: header claims 2 but only 1 endorsement present.
        assert!(!verify_hand_batch_stark(
            HAND_BINDING,
            p.span().slice(0, 8),
        ));
    }
}

