//! Hand-level batch verification of direct-sigma ownership endorsements on
//! the Cairo-native STARK curve (Plan D) — the EC_OP builtin variant of
//! `dual::hand_batch` (which runs secp256k1 syscalls).
//!
//! Why EC_OP: the STARK curve is the curve of the EC_OP builtin, so every
//! point operation is one native builtin step — the full 9-player residual
//! batch fits a single settlement transaction (see zgame
//! docs/plan-d-p3-metrics.md for the host-measured budget).
//!
//! Relationship to the secp variant (same payload layout, same binding
//! chain, different curve and challenge hash):
//! - Payload (felt252-range u256 words): [n_own, n_shuffle, n_reveal,
//!   n_leave, n_recon, buckets in that order — own: [pk_x, pk_y, r_x,
//!   r_y, s] × n_own; shuffle: BG bucket slot, **rejected fail-closed by
//!   this contract** (verified in `dual::hand_verify` instead); reveal/
//!   leave/recon as below]. Coordinates and
//!   scalars are < n < P, so every word is a valid felt252 and converts
//!   losslessly.
//! - Transcript domain: keccak256("poker/hand-batch/proto" ‖ hand_id) as
//!   LE bytes — identical to the secp variant and to the host's
//!   `hand_transcript_domain` (Rust sha3-Keccak256).
//! - Challenges and rho: Poseidon, NOT keccak. The host mints with
//!   `poker-protocol-core::StarkCurve::hash_to_scalar`, which is
//!   `poseidon_hash_many([len, 31-byte BE chunks]) mod n`; both the
//!   per-endorsement challenge and the hand rho replay exactly that
//!   framing here (`core::poseidon::poseidon_hash_span` is the same
//!   two-at-a-time Hades absorption as starknet-crypto's
//!   `poseidon_hash_many`).
//! - Point compression in challenge transcripts: the host's 32-byte
//!   canonical STARK encoding `byte0 = x_be[0] | (0x80 if y odd)` (NOT the
//!   33-byte SEC1 02/03 form used by the secp variant).
//! - Point arithmetic: corelib `EcPoint` (EC_OP builtin); `new` rejects
//!   off-curve payload points fail-closed; acceptance is
//!   `EcState::finalize_nz() == None` (the L == O identity test).
//!
//! Reveal-token, leave-DLEQ and reconstruct (CP-DLEQ) residuals fold here
//! (kinds 2/3/4). Bayer–Groth shuffle verification is implemented in
//! `dual::bg_stark` (pinned CK n=52, PoseidonFeltTranscript replay) but is
//! exercised by the **layer-2 program** (`dual::hand_verify`) only: inlining
//! it here pushes PokerDualSettlement CASM past the Starknet max bytecode
//! size, so this contract stays fail-closed on n_shuffle > 0.

use core::array::{ArrayTrait, SpanTrait};
use core::ec::{ec_point_unwrap, EcPoint, EcPointTrait, EcStateTrait, NonZeroEcPoint};
use core::num::traits::Zero;
use core::option::Option;
use core::poseidon::poseidon_hash_span;
use core::traits::TryInto;



/// The STARK curve group order (`starknet_curve::curve_params::EC_ORDER`,
/// identical constant to the host's `EC_ORDER_U256`). n < P, so every
/// canonical scalar is felt252-representable.
pub const STARK_N: u256 =
    0x0800000000000010ffffffffffffffffb781126dcae7b2321e66a241adc64d2f;

/// STARK curve generator (starknet_curve curve_params GENERATOR — the same
/// point Cairo's EC_OP builtin documentation uses).
pub const GENERATOR_X: felt252 =
    0x01ef15c18599971b7beced415a40f0c7deacfd9b0d1819e03d723d8bc943cfca;
pub const GENERATOR_Y: felt252 =
    0x005668060aa49730b7be4801df46ec62de53ecd11abe43a32873000c36e8dc1f;

/// DAPV transcript labels as felt（ASCII 直转，与 Rust core 的 ascii_felt
/// 逐字节一致派生；运行时零哈希成本）。
pub const HAND_PROTO_LABEL: felt252 = 0x706f6b65722f68616e642d62617463682f70726f746f; // "poker/hand-batch/proto"
pub const HAND_V1_LABEL: felt252 = 0x706f6b65722f68616e642d62617463682f7631; // "poker/hand-batch/v1"
pub const HAND_REVEAL_LABEL: felt252 = 0x706f6b65722f72657665616c2d746f6b656e2f666f6c642d7631; // "poker/reveal-token/fold-v1"
pub const HAND_LEAVE_LABEL: felt252 = 0x706f6b65722f6c656176652d666f6c642f7631; // "poker/leave-fold/v1"
pub const HAND_RECON_LABEL: felt252 = 'poker/reconstruct-fold/v1';

/// poseidon over felts then reduce mod n（challenge/rho 共用）。
pub fn poseidon_span_mod_n(input: Span<felt252>) -> u256 {
    let h = poseidon_hash_span(input);
    let h_u: u256 = h.into();
    h_u % STARK_N
}

pub fn nz_n() -> NonZero<u256> {
    let nz: Option<NonZero<u256>> = STARK_N.try_into();
    match nz {
        Option::Some(value) => value,
        Option::None => core::panic_with_felt252(0),
    }
}

/// `a · b mod n` — 512-bit safe via `core::math::u256_mul_mod_n`
/// (same primitive as fr.cairo, instantiated for the STARK group order).
pub fn fr_mul(a: u256, b: u256) -> u256 {
    core::math::u256_mul_mod_n(a, b, nz_n())
}

/// `−a mod n` (canonical input; zero maps to zero).
pub fn fr_neg(a: u256) -> u256 {
    if Zero::is_zero(@a) {
        0
    } else {
        STARK_N - a
    }
}

/// felt252 → u256 (lossless: felts are < P < 2^252).
pub fn felt_to_u256(f: felt252) -> u256 {
    f.into()
}

pub fn u256_to_felt(v: u256) -> Option<felt252> {
    v.try_into()
}











/// One accumulator term: `coeff · (x, y)` with coordinates as felts.
#[derive(Copy, Drop, Debug)]
pub struct TermStark {
    pub coeff: u256,
    pub x: felt252,
    pub y: felt252,
}

/// Ownership residual `s·G − R − c·pk` with the hand-bound challenge
/// c = poseidon(domain ‖ G32 ‖ pk32 ‖ R32) mod n — byte-identical to
/// `client-wasm::endorsement_mint` / `dual_settle::mint_endorsement`.
/// Per-endorsement residual as ONE equation point (A/B optimization):
///   eq = s·G − c·pk − R = s·G + c·(−pk) + (−R)
/// Negative terms use POINT negation (felt-level −y, the true group
/// inverse); c is the RAW poseidon output (< P) used directly as an EC
/// scalar — EC scalar mult is invariant under m → m mod n (group order),
/// so the host's reduced-c minting (s = w + c·sk in Z_n) and this raw-c
/// replay verify the same equation. No u256 arithmetic anywhere.
pub fn ownership_equation(
    hand_binding: felt252,
    pk: (felt252, felt252),
    big_r: (felt252, felt252),
    s: felt252,
) -> Option<(EcPoint, EquationWords)> {
    let (pk_x, pk_y) = pk;
    let (r_x, r_y) = big_r;
    let pk_point = match EcPointTrait::new(pk_x, pk_y) {
        Option::Some(p) => p,
        Option::None => { return Option::None; }, // off-curve: fail-closed
    };
    let r_point = match EcPointTrait::new(r_x, r_y) {
        Option::Some(p) => p,
        Option::None => { return Option::None; },
    };
    // c = poseidon([proto_label, hand_binding, Gx, Gy, pkx, pky, Rx, Ry])
    // — RAW (< P), no mod-n reduction (see fn doc).
    let input: Array<felt252> = array![
        HAND_PROTO_LABEL, hand_binding, GENERATOR_X, GENERATOR_Y, pk_x, pk_y, r_x, r_y
    ];
    let c = poseidon_hash_span(input.span());
    // rho 词：c 已绑定全部公开输入（抗碰撞），(kind, s, c) 足以绑定语句。
    let words = EquationWords { kind: 1, s, c };

    let g_nz: NonZeroEcPoint = EcPointTrait::new(GENERATOR_X, GENERATOR_Y).unwrap().try_into().unwrap();
    // 负项用点取反：−c·pk = c·(−pk)，−R 直接加 −R（域级 −y 即群逆）。
    let pk_neg_nz: NonZeroEcPoint = match (-pk_point).try_into() {
        Option::Some(nz) => nz,
        Option::None => { return Option::None; },
    };
    let r_neg_nz: NonZeroEcPoint = match (-r_point).try_into() {
        Option::Some(nz) => nz,
        Option::None => { return Option::None; },
    };
    let mut state = EcStateTrait::init();
    state.add_mul(s, g_nz);
    state.add_mul(c, pk_neg_nz);
    state.add(r_neg_nz);
    Option::Some((state.finalize(), words))
}


/// rho = poseidon("poker/hand-batch/v1" ‖ hand_id ‖ per-term
/// (coeff_be ‖ x_be ‖ y_be)) mod n — byte-identical to
/// `dual_settle::host_fold_check`'s rho derivation.
/// rho over the EQUATION words (A optimization):
///   rho = poseidon([v1_label, hand_binding, n_eq, (s, pkx, pky, Rx, Ry)*])
/// — RAW (< P) used directly as the Horner scalar; the host's
/// `dapv_hand_rho` reduces mod n and the two are EC-equivalent.
pub fn hand_rho(hand_binding: felt252, equations: Span<EquationWords>) -> felt252 {
    let mut input: Array<felt252> = array![HAND_V1_LABEL, hand_binding];
    input.append(equations.len().into());
    for eq in equations {
        let e: EquationWords = *eq;
        input.append(e.kind);
        input.append(e.s);
        input.append(e.c);
    }
    poseidon_hash_span(input.span())
}

/// rho transcript words of one folded equation: (kind, s, c).
/// c is recomputed on-chain from the equation's full public inputs
/// (poseidon collision-resistant), so these 3 felts bind the statement.
#[derive(Copy, Drop, Debug)]
pub struct EquationWords {
    pub kind: felt252,
    pub s: felt252,
    pub c: felt252,
}


/// Fold all residuals with powers of rho and accept iff `L == O`.
///
/// `EcState::add_mul` accumulates `lambda · point` in one EC_OP circuit per
/// term; `finalize_nz() == None` is the group's own identity test. The host
/// Horner fold (A optimization; host mirror: `dual_settle::host_fold_check`): accept iff
///   L = ρ·(ρ·(…(ρ·eq_N + eq_{N−1})…) + eq_1) == O.
/// Per equation: ONE add_mul(ρ, acc) + ONE add(eq) — no ρ power table,
/// no λ mod-n multiplications (the ±1 special case of optimization B
/// disappears structurally). `finalize_nz() == None` is the identity test.
pub fn fold_and_check(hand_binding: felt252, equations: Array<EcPoint>, words: Array<EquationWords>) -> bool {
    let n = equations.len();
    if n == 0 {
        return false;
    }
    let rho = hand_rho(hand_binding, words.span());
    let rho_nz_scalar = rho; // raw felt scalar; EC mult handles mod-n implicitly

    let mut acc = *equations.at(n - 1);
    let mut i: u32 = n - 1;
    while i > 0 {
        i -= 1;
        let eq_point = *equations.at(i);
        let eq_opt: Option<NonZeroEcPoint> = eq_point.try_into();
        // eq_i = O contributes nothing (ρ·acc + O = ρ·acc).
        if eq_opt.is_none() {
            continue;
        }
        let acc_opt: Option<NonZeroEcPoint> = acc.try_into();
        // acc = O mid-chain: ρ·O + eq_i = eq_i — restart accumulator here;
        // subsequent Horner steps resume correctly.
        if acc_opt.is_none() {
            acc = eq_point;
            continue;
        }
        let acc_nz = acc_opt.unwrap();
        let eq_nz = eq_opt.unwrap();
        let mut state = EcStateTrait::init();
        state.add_mul(rho_nz_scalar, acc_nz);
        state.add(eq_nz);
        acc = state.finalize();
    }
    // Accept iff the final accumulator is the identity point.
    let final_opt: Option<NonZeroEcPoint> = acc.try_into();
    match final_opt {
        Option::None => true,
        Option::Some(_) => false,
    }
}


/// Foldable reveal-token equations (felt-direct challenge epoch):
///   c = poseidon([reveal_label, hand_binding, pk, c1, c2, token, t1, t2, nonce])
/// (raw, < P — EC scalars are invariant under mod n).
///   eq1: s·G − t1 − c·pk = O
///   eq2: s·c1 − t2 − c·token = O
/// Negative terms via point negation (−c·pk = c·(−pk)).
/// Produces TWO equation points + one rho-words entry.
pub fn reveal_equations(
    hand_binding: felt252,
    pk: (felt252, felt252),
    c1: (felt252, felt252),
    c2: (felt252, felt252),
    token: (felt252, felt252),
    t1: (felt252, felt252),
    t2: (felt252, felt252),
    nonce: felt252,
    s: felt252,
) -> Option<((EcPoint, EcPoint), EquationWords)> {
    let (pk_x, pk_y) = pk;
    let (c1_x, c1_y) = c1;
    let (c2_x, c2_y) = c2;
    let (tok_x, tok_y) = token;
    let (t1_x, t1_y) = t1;
    let (t2_x, t2_y) = t2;
    // Off-curve fail-closed（EcPoint::new 验证曲线方程）。
    let pk_p = match EcPointTrait::new(pk_x, pk_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let c1_p = match EcPointTrait::new(c1_x, c1_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let c2_p = match EcPointTrait::new(c2_x, c2_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let tok_p = match EcPointTrait::new(tok_x, tok_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let t1_p = match EcPointTrait::new(t1_x, t1_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let t2_p = match EcPointTrait::new(t2_x, t2_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    // c2 与 token 的非恒等检查（恒等使语句退化）。
    let c2_opt: Option<NonZeroEcPoint> = c2_p.try_into();
    let tok_opt: Option<NonZeroEcPoint> = tok_p.try_into();
    if c2_opt.is_none() || tok_opt.is_none() {
        return Option::None;
    }

    let input: Array<felt252> = array![
        HAND_REVEAL_LABEL,
        hand_binding,
        pk_x, pk_y, c1_x, c1_y, c2_x, c2_y, tok_x, tok_y, t1_x, t1_y, t2_x, t2_y,
        nonce,
    ];
    let c = poseidon_hash_span(input.span());
    let words = EquationWords { kind: 2, s, c };

    let g_nz: NonZeroEcPoint = EcPointTrait::new(GENERATOR_X, GENERATOR_Y).unwrap().try_into().unwrap();
    let pk_neg: NonZeroEcPoint = match (-pk_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let t1_neg: NonZeroEcPoint = match (-t1_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let c1_nz: NonZeroEcPoint = match c1_p.try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let tok_neg: NonZeroEcPoint = match (-tok_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let t2_neg: NonZeroEcPoint = match (-t2_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };

    // eq1 = s·G + c·(−pk) + (−t1)
    let mut st1 = EcStateTrait::init();
    st1.add_mul(s, g_nz);
    st1.add_mul(c, pk_neg);
    st1.add(t1_neg);
    // eq2 = s·c1 + c·(−token) + (−t2)
    let mut st2 = EcStateTrait::init();
    st2.add_mul(s, c1_nz);
    st2.add_mul(c, tok_neg);
    st2.add(t2_neg);

    Option::Some(((st1.finalize(), st2.finalize()), words))
}

/// Foldable reconstruct (CP-DLEQ) equations, kind=4:
///   c = poseidon([recon_label, hand_binding, g1, g2, p1, p2, A, B])
/// (raw, < P — EC scalars are invariant under mod n; the host's
/// `handbatch_reconstruct_challenge` reduces mod n for minting, the two
/// verify the same equations).
///   eq1: s·g1 − A − c·p1 = O
///   eq2: s·g2 − B − c·p2 = O
/// Negative terms via point negation. Produces TWO equation points +
/// one rho-words entry (mirrors `HandBatchEquation::Reconstruct`).
pub fn reconstruct_equations(
    hand_binding: felt252,
    g1: (felt252, felt252),
    g2: (felt252, felt252),
    p1: (felt252, felt252),
    p2: (felt252, felt252),
    a: (felt252, felt252),
    b: (felt252, felt252),
    s: felt252,
) -> Option<((EcPoint, EcPoint), EquationWords)> {
    let (g1_x, g1_y) = g1;
    let (g2_x, g2_y) = g2;
    let (p1_x, p1_y) = p1;
    let (p2_x, p2_y) = p2;
    let (a_x, a_y) = a;
    let (b_x, b_y) = b;
    // Off-curve fail-closed (EcPoint::new verifies the curve equation).
    let g1_p = match EcPointTrait::new(g1_x, g1_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let g2_p = match EcPointTrait::new(g2_x, g2_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let p1_p = match EcPointTrait::new(p1_x, p1_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let p2_p = match EcPointTrait::new(p2_x, p2_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let a_p = match EcPointTrait::new(a_x, a_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let b_p = match EcPointTrait::new(b_x, b_y) { Option::Some(p) => p, Option::None => { return Option::None; } };

    let input: Array<felt252> = array![
        HAND_RECON_LABEL,
        hand_binding,
        g1_x, g1_y, g2_x, g2_y, p1_x, p1_y, p2_x, p2_y, a_x, a_y, b_x, b_y,
    ];
    let c = poseidon_hash_span(input.span());
    let words = EquationWords { kind: 4, s, c };

    let g1_nz: NonZeroEcPoint = match g1_p.try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let g2_nz: NonZeroEcPoint = match g2_p.try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let p1_neg: NonZeroEcPoint = match (-p1_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let p2_neg: NonZeroEcPoint = match (-p2_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let a_neg: NonZeroEcPoint = match (-a_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let b_neg: NonZeroEcPoint = match (-b_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };

    // eq1 = s·g1 + c·(−p1) + (−A)
    let mut st1 = EcStateTrait::init();
    st1.add_mul(s, g1_nz);
    st1.add_mul(c, p1_neg);
    st1.add(a_neg);
    // eq2 = s·g2 + c·(−p2) + (−B)
    let mut st2 = EcStateTrait::init();
    st2.add_mul(s, g2_nz);
    st2.add_mul(c, p2_neg);
    st2.add(b_neg);

    Option::Some(((st1.finalize(), st2.finalize()), words))
}

/// Foldable leave/remask batch DLEQ equations:
///   c = poseidon([leave_label, binding, pk, cpk, nonce, n,
///                 (in_c1, in_c2, out_c1, out_c2, a_i, d2_i)*])
///   with d2_i = in_c2_i − out_c2_i recomputed on-chain (point subtraction).
///   eq0:  s·G − cpk − c·pk = O
///   eq_i: s·in_c1ᵢ − aᵢ − c·d2ᵢ = O
/// Produces (1 + n) equation points + one rho-words entry.
pub fn leave_equations(
    hand_binding: felt252,
    pk: (felt252, felt252),
    cpk: (felt252, felt252),
    nonce: felt252,
    s: felt252,
    in_c1: Span<felt252>,
    in_c2: Span<felt252>,
    out_c1: Span<felt252>,
    out_c2: Span<felt252>,
    a: Span<felt252>,
) -> Option<(Array<EcPoint>, EquationWords)> {
    let (pk_x, pk_y) = pk;
    let (cpk_x, cpk_y) = cpk;
    let n = in_c1.len() / 2;
    if in_c2.len() != 2 * n || out_c1.len() != 2 * n || out_c2.len() != 2 * n || a.len() != 2 * n {
        return Option::None;
    }
    let pk_p = match EcPointTrait::new(pk_x, pk_y) { Option::Some(p) => p, Option::None => { return Option::None; } };
    let cpk_p = match EcPointTrait::new(cpk_x, cpk_y) { Option::Some(p) => p, Option::None => { return Option::None; } };

    // 挑战输入（含链上重算的 d2_i）
    let mut input: Array<felt252> = array![
        HAND_LEAVE_LABEL, hand_binding, pk_x, pk_y, cpk_x, cpk_y, nonce,
    ];
    input.append(n.into()); // 卡数（与 host dapv_leave_challenge 的 cards.len() 一致）
    let mut d2_points: Array<EcPoint> = array![];
    let mut i: u32 = 0;
    while i < n {
        let in_c1x = *in_c1.at(2 * i); let in_c1y = *in_c1.at(2 * i + 1);
        let in_c2x = *in_c2.at(2 * i); let in_c2y = *in_c2.at(2 * i + 1);
        let out_c1x = *out_c1.at(2 * i); let out_c1y = *out_c1.at(2 * i + 1);
        let out_c2x = *out_c2.at(2 * i); let out_c2y = *out_c2.at(2 * i + 1);
        let ax = *a.at(2 * i); let ay = *a.at(2 * i + 1);
        // on-curve fail-closed
        let _in_c1_p = match EcPointTrait::new(in_c1x, in_c1y) { Option::Some(p) => p, Option::None => { return Option::None; } };
        let in_c2_p = match EcPointTrait::new(in_c2x, in_c2y) { Option::Some(p) => p, Option::None => { return Option::None; } };
        let out_c1_p = match EcPointTrait::new(out_c1x, out_c1y) { Option::Some(p) => p, Option::None => { return Option::None; } };
        let out_c2_p = match EcPointTrait::new(out_c2x, out_c2y) { Option::Some(p) => p, Option::None => { return Option::None; } };
        let _a_p = match EcPointTrait::new(ax, ay) { Option::Some(p) => p, Option::None => { return Option::None; } };
        let _ = out_c1_p;
        // d2 = in_c2 − out_c2
        let d2 = in_c2_p - out_c2_p;
        // d2 词（恒等记 (0,0)，与 host dapv_leave_challenge 同判）
        let d2_nz_opt: Option<NonZeroEcPoint> = d2.try_into();
        let (d2x, d2y) = match d2_nz_opt {
            Option::Some(nz) => ec_point_unwrap(nz),
            Option::None => (0, 0),
        };
        d2_points.append(d2);
        input.append(in_c1x); input.append(in_c1y);
        input.append(in_c2x); input.append(in_c2y);
        input.append(out_c1x); input.append(out_c1y);
        input.append(out_c2x); input.append(out_c2y);
        input.append(ax); input.append(ay);
        input.append(d2x); input.append(d2y);
        i += 1;
    }
    let c = poseidon_hash_span(input.span());
    let words = EquationWords { kind: 3, s, c };

    let g_nz: NonZeroEcPoint = EcPointTrait::new(GENERATOR_X, GENERATOR_Y).unwrap().try_into().unwrap();
    let pk_neg: NonZeroEcPoint = match (-pk_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } };
    let mut out_eqs: Array<EcPoint> = array![];
    // eq0 = s·G − cpk − c·pk
    let mut st0 = EcStateTrait::init();
    st0.add_mul(s, g_nz);
    st0.add(match (-cpk_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } });
    st0.add_mul(c, pk_neg);
    out_eqs.append(st0.finalize());
    // eq_i = s·in_c1ᵢ − aᵢ − c·d2ᵢ
    i = 0;
    while i < n {
        let in_c1_p = EcPointTrait::new(*in_c1.at(2 * i), *in_c1.at(2 * i + 1)).unwrap();
        let a_p = EcPointTrait::new(*a.at(2 * i), *a.at(2 * i + 1)).unwrap();
        let d2 = *d2_points.at(i);
        let mut st = EcStateTrait::init();
        st.add_mul(s, match in_c1_p.try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } });
        st.add(match (-a_p).try_into() { Option::Some(nz) => nz, Option::None => { return Option::None; } });
        // d2 = O（in==out，防亮牌排除槽）时项消失
        // −c·d2：d2 取反（host: (−d2)·c）
        let d2_neg: EcPoint = -d2;
        let d2_neg_opt: Option<NonZeroEcPoint> = d2_neg.try_into();
        match d2_neg_opt {
            Option::Some(d2_nz) => { st.add_mul(c, d2_nz); },
            Option::None => { let _ = c; },
        }
        out_eqs.append(st.finalize());
        i += 1;
    }
    Option::Some((out_eqs, words))
}

/// Verify a hand's full proof batch in one folded EC_OP check.
/// Fail-closed on malformed payloads and off-curve points.
/// Canonical header (5 words, hand-batch v2.8 equation order):
/// [n_own, n_shuffle, n_reveal, n_leave, n_recon]; buckets follow in that
/// order. The recon bucket is the CP-DLEQ reconstruct equations (kind=4).
/// The shuffle bucket is **rejected fail-closed** — BG verification is the
/// layer-2 program's job (`dual::hand_verify` via `dual::bg_stark`); see
/// the module docs for the bytecode-size rationale.
pub fn verify_hand_batch_stark(hand_binding: felt252, payload: Span<felt252>) -> bool {
    if payload.len() < 5 {
        return false;
    }
    // 规范头（5 词，DAPV v2.8 方程序序）：[n_own, n_shuffle, n_reveal, n_leave, n_recon]
    let n_own = felt_to_u256(*payload.at(0));
    let n_shuffle = felt_to_u256(*payload.at(1));
    let n_reveal = felt_to_u256(*payload.at(2));
    let n_leave = felt_to_u256(*payload.at(3));
    let n_recon = felt_to_u256(*payload.at(4));
    let n_own_u32: u32 = match n_own.try_into() {
        Option::Some(v) => v,
        Option::None => { return false; },
    };
    let _n_shuffle_u32: u32 = match n_shuffle.try_into() {
        Option::Some(v) => v,
        Option::None => { return false; },
    };
    let n_reveal_u32: u32 = match n_reveal.try_into() {
        Option::Some(v) => v,
        Option::None => { return false; },
    };
    let n_leave_u32: u32 = match n_leave.try_into() {
        Option::Some(v) => v,
        Option::None => { return false; },
    };
    let n_recon_u32: u32 = match n_recon.try_into() {
        Option::Some(v) => v,
        Option::None => { return false; },
    };
    if payload.len() < 5 + 5 * n_own_u32 + 14 * n_reveal_u32 + 13 * n_recon_u32 {
        return false;
    }
    let mut equations: Array<EcPoint> = array![];
    let mut words: Array<EquationWords> = array![];
    let mut i: u32 = 0;
    let mut cursor: u32 = 5;
    while i < n_own_u32 {
        let s_felt = *payload.at(cursor + 4);
        let (pk_x, pk_y) = (*payload.at(cursor), *payload.at(cursor + 1));
        let (r_x, r_y) = (*payload.at(cursor + 2), *payload.at(cursor + 3));
        let (eq, w) = match ownership_equation(hand_binding, (pk_x, pk_y), (r_x, r_y), s_felt) {
            Option::Some(v) => v,
            Option::None => { return false; }, // off-curve: fail-closed
        };
        equations.append(eq);
        words.append(w);
        cursor += 5;
        i += 1;
    }
    // ---- shuffle bucket: BG verification lives in the layer-2 program ----
    // (dual::hand_verify + dual::bg_stark). Inlining the BG module here pushes
    // PokerDualSettlement CASM past the Starknet max bytecode size
    // (81,290 felts), so the layer-1 contract stays lean and **fail-closed**
    // on n_shuffle > 0: never accept a statement this contract cannot fully
    // verify. Settlements carrying shuffle proofs take the program route.
    if n_shuffle != 0_u256 {
        return false;
    }
    i = 0;
    while i < n_reveal_u32 {
        // [pk 2, c1 2, c2 2, token 2, t1 2, t2 2, nonce, s]
        let pk = (*payload.at(cursor), *payload.at(cursor + 1));
        let c1 = (*payload.at(cursor + 2), *payload.at(cursor + 3));
        let c2 = (*payload.at(cursor + 4), *payload.at(cursor + 5));
        let token = (*payload.at(cursor + 6), *payload.at(cursor + 7));
        let t1 = (*payload.at(cursor + 8), *payload.at(cursor + 9));
        let t2 = (*payload.at(cursor + 10), *payload.at(cursor + 11));
        let nonce = *payload.at(cursor + 12);
        let s_felt = *payload.at(cursor + 13);
        let ((eq1, eq2), w) = match reveal_equations(
            hand_binding, pk, c1, c2, token, t1, t2, nonce, s_felt,
        ) {
            Option::Some(v) => v,
            Option::None => { return false; },
        };
        equations.append(eq1);
        equations.append(eq2);
        words.append(w);
        cursor += 14;
        i += 1;
    }
    i = 0;
    while i < n_leave_u32 {
        // [n, pk 2, cpk 2, nonce, s, in_c1 2n, in_c2 2n, out_c1 2n, out_c2 2n, a 2n]
        let n_cards_f = felt_to_u256(*payload.at(cursor));
        let n_cards: u32 = match n_cards_f.try_into() {
            Option::Some(v) => v,
            Option::None => { return false; },
        };
        if payload.len() < (cursor + 7 + 10 * n_cards) {
            return false;
        }
        let pk = (*payload.at(cursor + 1), *payload.at(cursor + 2));
        let cpk = (*payload.at(cursor + 3), *payload.at(cursor + 4));
        let nonce = *payload.at(cursor + 5);
        let s_felt = *payload.at(cursor + 6);
        let base = cursor + 7;
        let in_c1 = payload.slice(base, 2 * n_cards);
        let in_c2 = payload.slice(base + 2 * n_cards, 2 * n_cards);
        let out_c1 = payload.slice(base + 4 * n_cards, 2 * n_cards);
        let out_c2 = payload.slice(base + 6 * n_cards, 2 * n_cards);
        let a = payload.slice(base + 8 * n_cards, 2 * n_cards);
        let (mut eq_pts, w) = match leave_equations(
            hand_binding, pk, cpk, nonce, s_felt, in_c1, in_c2, out_c1, out_c2, a,
        ) {
            Option::Some(v) => v,
            Option::None => { return false; },
        };
        let mut k: u32 = 0;
        while k < eq_pts.len() {
            let p = *eq_pts.at(k);
            equations.append(p);
            k += 1;
        }
        words.append(w);
        cursor += 7 + 10 * n_cards;
        i += 1;
    }
    // ---- recon bucket: CP-DLEQ reconstruct (kind=4) ----
    i = 0;
    while i < n_recon_u32 {
        // [g1 2, g2 2, p1 2, p2 2, A 2, B 2, s]
        let g1 = (*payload.at(cursor), *payload.at(cursor + 1));
        let g2 = (*payload.at(cursor + 2), *payload.at(cursor + 3));
        let p1 = (*payload.at(cursor + 4), *payload.at(cursor + 5));
        let p2 = (*payload.at(cursor + 6), *payload.at(cursor + 7));
        let a = (*payload.at(cursor + 8), *payload.at(cursor + 9));
        let b = (*payload.at(cursor + 10), *payload.at(cursor + 11));
        let s_felt = *payload.at(cursor + 12);
        let ((eq1, eq2), w) = match reconstruct_equations(
            hand_binding, g1, g2, p1, p2, a, b, s_felt,
        ) {
            Option::Some(v) => v,
            Option::None => { return false; },
        };
        equations.append(eq1);
        equations.append(eq2);
        words.append(w);
        cursor += 13;
        i += 1;
    }
    fold_and_check(hand_binding, equations, words)
}

