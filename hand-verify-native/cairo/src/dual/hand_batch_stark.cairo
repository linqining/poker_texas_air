    #[test]
    fn full_hand_n2_accepts() {
        assert!(
            verify_hand_batch_stark(FULL_HAND_BINDING, full_hand_payload_n2().span()),
            "Full hand 2p: 2 ownership + 18 foldable reveals (counts from the real full_hand flow) must fold to L == O"
        );
    }

    #[test]
    fn full_hand_n2_accepts_tampered() {
        let p = full_hand_payload_n2();
        // 篡改最后一个 reveal 的 s（末词）+1
        let last: u32 = (p.len() - 1).try_into().unwrap();
        let bumped = bumped(p, last);
        assert!(!verify_hand_batch_stark(FULL_HAND_BINDING, bumped.span()));
    }


