    #[test]
    fn full_hand_n9_accepts() {
        assert!(
            verify_hand_batch_stark(FULL_HAND_BINDING, full_hand_payload_n9().span()),
            "Full hand 9p: 9 ownership + 207 foldable reveals (preflop 144 + community 45 + showdown 18) must fold to L == O"
        );
    }

    #[test]
    fn full_hand_n9_accepts_tampered() {
        let p = full_hand_payload_n9();
        // 篡改最后一个 reveal 的 s（末词）+1
        let last: u32 = (p.len() - 1).try_into().unwrap();
        let bumped = bumped(p, last);
        assert!(!verify_hand_batch_stark(FULL_HAND_BINDING, bumped.span()));
    }

    
